# Let Git detect text files and normalize line endings.
* text=auto

# Markdown and template files
*.md text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf

# Shell scripts
*.sh text eol=lf

# JSON / YAML config
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Images (if added later)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary